# Copy this file to `.env` and edit. Do not commit `.env`.

# Local SQLite file created on first run.
DATABASE_URL=sqlite:///./pipeline.db

# Built-in sources: jsonplaceholder | http_json | file_json
SOURCE_NAME=jsonplaceholder

# Local JSON array for the file_json example plugin (no HTTP).
# SOURCE_NAME=file_json
# SOURCE_FILE=examples/records.json

# Built-in processors: word_count (default) | numeric
PROCESSOR_NAME=word_count

# HTTP JSON endpoint. MOCK_API_URL is a legacy alias for SOURCE_URL.
SOURCE_URL=https://jsonplaceholder.typicode.com/posts
# MOCK_API_URL=https://jsonplaceholder.typicode.com/posts

# Used when SOURCE_NAME=http_json. Dotted paths are allowed (e.g. event.id).
# Record ids are stored as text (JSONPlaceholder integer 1 → "1"). http_json accepts
# integers, numeric strings, UUIDs, and slugs; blank ids are rejected.
SOURCE_ID_FIELD=id
SOURCE_TEXT_FIELD=body

# When PROCESSOR_NAME=numeric, dotted path to the number to score on each row.
# SOURCE_VALUE_FIELD=reading

# Optional: when the API returns { "data": [ ... ] } instead of a root array.
# SOURCE_ITEMS_PATH=data

# Optional pagination for http_json. Use next-link OR page query param, not both.
# JSONPlaceholder stays one request; http_json with both empty is one GET.
# All pages merge into one pipeline run; duplicate ids across pages are rejected.
# Dotted path to the next page URL on each JSON object (e.g. next or links.next).
# Requires SOURCE_ITEMS_PATH. Missing, null, or blank stops. Same SOURCE_AUTH_* header
# on every page.
# SOURCE_NEXT_FIELD=next
# Query parameter name (e.g. page). Starts at 1; stops when a page has an empty item list.
# Works with a root array or with SOURCE_ITEMS_PATH.
# SOURCE_PAGE_PARAM=page
# Maximum GETs per fetch; exceeding this is an error.
# SOURCE_MAX_PAGES=10

# Optional HTTP auth for http_json (and any source that uses the shared HTTP client).
SOURCE_AUTH_HEADER=Authorization
# Sent verbatim as that header. Example only — use a real token in .env, never commit it.
# SOURCE_AUTH_TOKEN=Bearer your-token

INGESTION_INTERVAL_SECONDS=300
SCHEDULER_ENABLED=true
HTTP_TIMEOUT_SECONDS=30
